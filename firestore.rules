rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isInstructor() {
      return isAuthenticated() && 
        (getUserData().role == 'instructor' || getUserData().role == 'faculty') &&
        getUserData().approvalStatus == 'APPROVED';
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    // Users collection (roster matching & authentication)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isUser(userId) || isAdmin();
    }

    // Instructors collection
    match /instructors/{instructorId} {
      allow read: if isAuthenticated();
      allow write: if (isAuthenticated() && request.auth.uid == instructorId) || isAdmin();
    }

    // Course catalog & assigned schedules (read-only for instructors, managed by Registrar / Admin)
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Authoritative lecture sessions
    match /classSessions/{sessionId} {
      allow read: if isAuthenticated();
      // Only the assigned instructor or admin can initiate, update telemetry, and seal sessions
      allow create: if isInstructor() && request.resource.data.instructorId == request.auth.uid;
      allow update: if isInstructor() && resource.data.instructorId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Student attendance records
    match /studentAttendance/{attendanceId} {
      allow read: if isAuthenticated();
      // Students write their initial geofence ping; instructor can review or override; admin full access
      allow create: if isAuthenticated();
      allow update: if isInstructor() || isAdmin();
      allow delete: if isAdmin();
    }

    // Real-time alerts and campus dispatch
    match /alerts/{alertId} {
      allow read: if isAuthenticated();
      allow write: if isInstructor() || isAdmin();
    }

    // Cryptographic audit logs (immutable ledger)
    match /auditLogs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Append-only immutable ledger
    }
  }
}
